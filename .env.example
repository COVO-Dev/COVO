# COVO Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============= EMAIL CONFIGURATION =============
# Docker Health Monitor & System Alerts
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ALERT_TO=alert_recipient@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ============= DATABASE CONFIGURATION =============
# MongoDB Atlas URLs - Replace with your actual connection strings
MONGODB_MAIN_URL=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority&appName=YourApp
MONGODB_METRICS_URL=mongodb+srv://username:password@cluster.mongodb.net/metrics_database?retryWrites=true&w=majority&appName=YourApp

# ============= REDIS CONFIGURATION =============
# Redis password for session storage and caching - Generate with: openssl rand -base64 32
REDIS_PASSWORD=your_secure_redis_password_here

# ============= APPLICATION CONFIGURATION =============
# Environment
NODE_ENV=production

# API URLs - Update these for your production environment
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com
SERVER_URL=http://covo-server:8000

# ============= AUTHENTICATION =============
# NextAuth.js configuration - Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=https://yourdomain.com

# ============= SECURITY NOTES =============
# 1. Never commit the actual .env file to version control
# 2. Use HTTPS URLs in production
# 3. Generate all secrets using cryptographically secure methods
# 4. Rotate secrets regularly
# 5. Use environment-specific values for different deployments
